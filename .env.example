# ---------------------------------------------------------------------------
# SSAMS configuration template.
#   1. Copy this file to `.env` in the repository root (the setup scripts do it).
#   2. Replace SESSION_SECRET and BIOMETRIC_ENCRYPTION_KEY with generated values:
#        Windows: cd backend; .\.venv\Scripts\python.exe -m app.cli generate-secrets
#        Linux:   cd backend && .venv/bin/python -m app.cli generate-secrets
#   3. Never commit the real .env or reuse its secrets between environments.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# --- Unified port (frontend + API) -----------------------------------------
# One server owns this port: it serves the built React application at / and the
# backend at /api. A tunnel therefore only has to expose this single port.
# Bind to 0.0.0.0 so ngrok, Cloudflare Tunnel or a phone on the LAN can reach it.
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Application (business) timezone ---------------------------------------
# Asia/Kolkata = IST = UTC+05:30. Attendance days, class windows, lateness,
# reports, exports, API timestamps and log lines all use this zone.
# Timestamps are still stored internally as UTC instants so the recorded moment
# stays exact; this setting controls how that moment is interpreted and shown.
CAMPUS_TIMEZONE=Asia/Kolkata

# Optional convenience for Linux/macOS shell tooling. The application derives its
# business timezone from CAMPUS_TIMEZONE, and Windows ignores TZ entirely, so no
# Windows system setting has to be changed.
TZ=Asia/Kolkata

# --- Database --------------------------------------------------------------
# Local development/test default (relative to the backend working directory).
DATABASE_URL=sqlite:///../data/ssams.db
# Production target (URL-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg://ssams_app:CHANGE-ME@127.0.0.1:5432/ssams?sslmode=verify-full

# --- Secrets (required before the app will authenticate anything) ----------
SESSION_SECRET=replace-with-a-generated-session-secret
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- Cookies / transport ---------------------------------------------------
# false for local http://localhost testing; true when the browser uses HTTPS
# (institutional TLS proxy, ngrok, Cloudflare Tunnel). APP_ENV=production also
# forces Secure cookies and HSTS.
COOKIE_SECURE=false

# --- Static frontend / models ---------------------------------------------
# Built React application, relative to the repository root (npm run build).
FRONTEND_DIST=frontend/dist
# Directory with the pinned local face models; they are never downloaded at startup.
MODEL_DIR=models

# --- CORS (usually not needed) ---------------------------------------------
# The frontend and the API share one origin, so no CORS entry is required.
# Only list exact origins for a deliberate cross-origin deployment; a wildcard
# is never accepted here because sessions use credentialed cookies.
# CORS_ORIGINS=https://attendance.example.edu
