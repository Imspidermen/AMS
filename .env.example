# Copy to .env; generate SESSION_SECRET and BIOMETRIC_ENCRYPTION_KEY with:
# python -m app.cli generate-secrets (from backend with its virtual environment active)
APP_ENV=development
APP_NAME=SSAMS
DATABASE_URL=sqlite:///../data/ssams.db
SESSION_SECRET=replace-with-at-least-32-random-bytes
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-fernet-key
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
CAMPUS_TIMEZONE=UTC
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_DIR=models
FACE_MATCH_THRESHOLD=0.363
GEOFENCE_MAX_READING_AGE_SECONDS=120
MAX_UPLOAD_BYTES=2097152
LOW_ATTENDANCE_THRESHOLD=75
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://ssams_app:change-me@localhost:5432/ssams
